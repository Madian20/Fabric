		lineageTag: 828cc702-c732-479d-9a8d-6d14b589a792
		sourceLineageTag: f112a689-1d23-4d39-b484-31a17844ec40
		sourceColumn: order_delivered_carrier_date

	/// Date the order was delivered to the customer.
