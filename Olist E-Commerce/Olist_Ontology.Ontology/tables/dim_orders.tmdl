/// One row per order, the hub of the model. Holds order status and lifecycle dates, and links to customers, the date table, and all fact tables.
table dim_orders
	lineageTag: c2deb544-d858-4234-92fe-2aa93357e146
	sourceLineageTag: e4e0642c-dcc4-4743-9d35-0883e6af8816

	/// Unique identifier of the order (primary key).
	column order_id
		dataType: string
		lineageTag: c2bd1b47-6c05-4994-93fa-343cd83123b7
		sourceLineageTag: 4d869396-6723-456f-b728-bdb4ce00cdf6
		sourceColumn: order_id

	/// Order-level customer key, linking the order to dim_customers.
	column customer_id
		dataType: string
		lineageTag: 80f45ab2-51a1-4126-a633-f041c30339b3
		sourceLineageTag: 2aaa031d-3f47-4d19-950e-dc4ba1a37e58
		sourceColumn: customer_id

	/// Current status of the order (e.g., delivered, shipped, canceled).
	column order_status
		dataType: string
		lineageTag: ef2beecc-0584-48ef-bb3f-676b3b436b19
		sourceLineageTag: 33e59cf5-a402-41a9-be85-84e15b0062a5
		sourceColumn: order_status

	/// Date and time the customer placed the order.
	column order_purchase_timestamp
		dataType: dateTime
		lineageTag: baf61e43-52f8-437e-a057-ef5ec77bb271
		sourceLineageTag: 1d125206-d5ab-4a43-a896-27e51c9fce47
		sourceColumn: order_purchase_timestamp

	/// Date and time the payment was approved.
	column order_approved_at
		dataType: dateTime
		lineageTag: 9f4f2611-98c6-4d09-8c83-6f638635d5d8
		sourceLineageTag: 98e66b4c-da87-4ec0-ab47-da46d42da8b8
		sourceColumn: order_approved_at

	/// Date the order was handed to the logistics carrier.
	column order_delivered_carrier_date
