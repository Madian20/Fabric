	/// Order the item belongs to (links to dim_orders).
	column order_id
		dataType: string
		lineageTag: 4f195870-f662-4172-94c1-6f9c549c6707
		sourceLineageTag: f6ce84da-5318-4246-b818-aa0c6b5eb8b5
		sourceColumn: order_id

	/// Sequence number of the item within the order. Together with order_id it identifies the row.
	column order_item_id
		dataType: int64
		lineageTag: e0d85e83-df97-4fd6-aab7-b89de44ad5b2
		sourceLineageTag: 921fb066-8f11-45be-aa77-cd300e8607ea
		sourceColumn: order_item_id

	/// Seller who fulfilled the item (links to dim_sellers).
