		sourceColumn: seller_id

	/// Deadline for the seller to hand the item to the carrier.
	column shipping_limit_date
		dataType: dateTime
		lineageTag: 5a442331-e340-429c-b7da-b105ff601a84
		sourceLineageTag: 12e2f7bf-ed4b-49ae-a898-8e07f506d132
		sourceColumn: shipping_limit_date

	/// Item price, excluding freight.
