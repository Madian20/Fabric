	lineageTag: 8a90bde8-129b-464d-a36b-b6f1821d379d
	sourceLineageTag: 14060607-e69b-4cbd-a19c-4d580a15105b

	/// Product sold (links to dim_products).
	column product_id
		dataType: string
		lineageTag: 1ad86186-1954-4087-809a-a344e5a5cc68
		sourceLineageTag: 5c9a8d72-63ad-40ab-a4a3-635a4347ab46
