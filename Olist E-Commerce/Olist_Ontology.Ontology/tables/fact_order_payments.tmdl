/// One row per payment record. An order can have several payments (e.g., voucher plus card).
table fact_order_payments
	lineageTag: 724327f4-ffc4-49d0-8f8e-0310b2d64ddb
	sourceLineageTag: 94edb749-25a9-426a-bfc2-26ce1315a1eb

	/// Order the payment belongs to (links to dim_orders).
	column order_id
		dataType: string
		lineageTag: c014b03e-2cb3-4ab1-93b6-8ca81a43b87b
		sourceLineageTag: 4dbbf421-703e-47de-9e26-2207800c9282
		sourceColumn: order_id

	/// Sequence number of the payment within the order.
	column payment_sequential
		dataType: int64
