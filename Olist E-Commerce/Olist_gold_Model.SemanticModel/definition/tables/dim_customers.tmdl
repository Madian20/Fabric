/// One row per customer ID, with location details.
table dim_customers
	lineageTag: ee17c30e-134b-492c-855e-3e2c0ad029ab
	sourceLineageTag: [dbo].[dim_customers]

	/// Order-level customer key, one-to-one with dim_orders.
	column customer_id
		dataType: string
		sourceProviderType: varchar(-1)
		lineageTag: fbeaa20e-9483-43d4-8f2b-e227356683e4
		sourceLineageTag: customer_id
		summarizeBy: none
		sourceColumn: customer_id

		annotation SummarizationSetBy = Automatic

	/// Persistent identifier of the actual customer. Use it to count unique customers or repeat buyers.
	column customer_unique_id
		dataType: string
		sourceProviderType: varchar(-1)
		lineageTag: 5ae60f07-11f7-4b56-9968-0d85413d216a
