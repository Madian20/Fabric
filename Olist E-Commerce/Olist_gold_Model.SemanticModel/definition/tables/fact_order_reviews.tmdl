	/// Unique identifier of the review.
	column review_id
		dataType: string
		sourceProviderType: varchar(-1)
		lineageTag: f7bfa893-5cc7-418a-bfa0-a1ab53479b37
		sourceLineageTag: review_id
		summarizeBy: none
		sourceColumn: review_id

